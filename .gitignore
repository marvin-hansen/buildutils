# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Arbitrary context that helps coding agents
/ctx/
/ctx/*

# Cargo stuff
debug/
debug/*
debug/*.*
/target/
/target/*
/target/*.*

# Bazel stuff
/target-bzl/
/target-bzl/*
/target-bzl/*.*

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock
.cargo/config.toml
.cargo/config

# These are backup files generated by rustfmt
**/*.rs.bk

# Jetbrains files & folders
.idea
.idea/
.idea/*.*

# Visual Studio Code stuff
.vscode

# Apple stuff
.DS_Store
*/.DS_Store

# windsurf rules
.windsurfrules

# Service binary staged by scripts/test_cargo.sh so Cargo can run the service_utils example.
# Bazel materialises its own copy from the test target's data, so this is a local artifact.
/examples/service_utils_example/tests/service
