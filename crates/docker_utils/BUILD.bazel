load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")

rust_library(
    name = "docker_utils",
    srcs = glob([
        "src/*.rs",
        "src/*/*.rs",
    ]),
    crate_root = "src/lib.rs",
    tags = [
        "docker_utils",
        "utils-test",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Internal crates
        "//alias:wait_utils",
        # External crates
        "//thirdparty/crates:bon",
        "//thirdparty/crates:tokio",
    ],
)

# Runs the #[cfg(test)] modules inside src/. These do not drive Docker, so they need no
# daemon, unlike the integration tests under tests/.
rust_test(
    name = "lib_unit_tests",
    crate = ":docker_utils",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
)

rust_doc(
    name = "doc",
    crate = ":docker_utils",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":docker_utils",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)
